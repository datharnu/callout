# Copy to .env (gitignored). Secrets live ONLY here, never in glasses/.

# ── Required ──────────────────────────────────────────────────────────────────────────────────
# Bybit DEMO Trading keys: log into bybit.com → switch to Demo Trading → avatar → API.
# Keys created on the live account will NOT work against api-demo.bybit.com.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Telegram bot from @BotFather. Run /setprivacy → Disable, then remove + re-add the bot to the group.
TELEGRAM_BOT_TOKEN=

# Allowlist (comma-separated). Groups to read, and senders whose messages can become calls.
# Include sender_chat IDs for anonymous admins / channel posts. Run `npm run tg:listen` to find IDs.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_SENDER_IDS=

# Anthropic API key for the parser (Claude Haiku 5.5, extraction only).
ANTHROPIC_API_KEY=

# ElevenLabs API key for voice commands (speech-to-text, Scribe). Audio is only sent while a card is shown.
ELEVENLABS_API_KEY=

# ── Optional settings (defaults shown) ──────────────────────────────────────────────────────
# CALLOUT_SIZE_USD=200               # size per order; never set by the AI
# CALLOUT_MAX_SIZE_USD=500           # cap; the code also enforces a hard max of 1000
# CALLOUT_MAX_TRADES_PER_DAY=5       # 0 disables (UTC day)
# CALLOUT_MAX_DAILY_LOSS_USD=50      # 0 disables (realised P&L, UTC day)
# CALLOUT_PAUSE_AFTER_LOSSES=2       # 0 disables
# CALLOUT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,TONUSDT
# CALLOUT_MAX_ENTRY_DISTANCE_PCT=3
# CALLOUT_CALL_EXPIRY_MIN=15
# CALLOUT_CANCEL_WINDOW_SEC=5
# CALLOUT_DEMO_MODE=0                # 1 enables POST /api/demo/message (replay)
# PORT=8787
# HOST=127.0.0.1                     # keep local: the API has no pairing/auth yet
# CALLOUT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CALLOUT_DB=backend/data/callout.sqlite
# CALLOUT_NO_TELEGRAM=0              # 1 runs without the bot (replay only)
# CALLOUT_STT_KEYTERMS=1             # 0 disables biasing recognition toward safe command words
